# Postgres connection string for the Food Palace database.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/food_palace?schema=public"

# JWT secrets for API authentication and session management.
JWT_SECRET="replace-with-a-strong-jwt-secret"
JWT_REFRESH_SECRET="replace-with-a-strong-refresh-secret"

# Public application URL used for redirects and absolute links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Next Auth / session support.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-strong-nextauth-secret"

# Stripe configuration for payments.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Email delivery and operational settings.
SENDGRID_API_KEY="replace-with-sendgrid-api-key"
SUPPORT_EMAIL="support@foodpalace.ng"

# Optional feature flags.
NEXT_PUBLIC_ENABLE_REVIEW_MODERATION="true"
NEXT_PUBLIC_ALLOW_GUEST_CHECKOUT="false"
